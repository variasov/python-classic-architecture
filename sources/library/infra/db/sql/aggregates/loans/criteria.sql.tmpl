{#
  Критерии агрегата Loan. Таблица loans - алиас l.
  Значения вставляются литералами (sqlsafe): см. комментарий в aggregates/books/criteria.sql.tmpl.
#}
{% macro overdue(criteria) -%}
    (l.returned_at IS NULL AND l.due < DATE '{{ criteria.on.isoformat() | sqlsafe }}')
{%- endmacro %}

{% macro returned(criteria) -%}
    (l.returned_at IS NOT NULL)
{%- endmacro %}

{% macro due_within(criteria) -%}
    (l.returned_at IS NULL
     AND l.due BETWEEN DATE '{{ criteria.on.isoformat() | sqlsafe }}'
         AND DATE '{{ criteria.on.isoformat() | sqlsafe }}' + {{ criteria.days | int | sqlsafe }})
{%- endmacro %}

{% macro of_reader(criteria) -%}
    (l.reader_id = {{ criteria.reader_id | int | sqlsafe }})
{%- endmacro %}
