{#
  Критерии агрегата Book. Таблица books - алиас b.
  Значения критериев вставляются литералами (sqlsafe), а не bind-параметрами: autobind
  classic-db-tools называет параметр по выражению (`criteria.year`), и два критерия
  одного класса в одном дереве затирают значения друг друга. Числа приводятся к int,
  строки экранируются.
#}
{% macro has_available_copies(criteria) -%}
    EXISTS (SELECT 1 FROM library.copies x WHERE x.book_id = b.id AND x.is_available)
{%- endmacro %}

{% macro published_after(criteria) -%}
    (b.published_year > {{ criteria.year | int | sqlsafe }})
{%- endmacro %}

{% macro written_by(criteria) -%}
    ('{{ criteria.author | replace("'", "''") | replace("%", "%%") | sqlsafe }}' = ANY (b.authors))
{%- endmacro %}
