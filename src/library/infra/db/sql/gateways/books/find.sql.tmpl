SELECT
    b.id AS BookDTO__id,
    b.isbn AS BookDTO__isbn,
    b.title AS BookDTO__title,
    b.authors AS BookDTO__authors,
    b.published_year AS BookDTO__published_year
FROM library.books b
WHERE TRUE
{% if title_like is not none %}
    AND b.title ILIKE {{ title_like }}
{% endif %}
{% if author is not none %}
    AND {{ author }} = ANY(b.authors)
{% endif %}
{% if only_available %}
    AND EXISTS (
        SELECT 1
        FROM library.copies c
        WHERE c.book_id = b.id AND c.is_available
    )
{% endif %}
{% if year_from is not none %}
    AND b.published_year >= {{ year_from }}
{% endif %}
{% if year_to is not none %}
    AND b.published_year <= {{ year_to }}
{% endif %}
ORDER BY {{ sort_column | identifier }} {{ sort_direction | sqlsafe }}
LIMIT {{ limit }} OFFSET {{ offset }}
