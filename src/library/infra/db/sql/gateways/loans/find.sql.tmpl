SELECT
    l.id AS LoanDTO__id,
    l.reader_id AS LoanDTO__reader_id,
    l.book_id AS LoanDTO__book_id,
    l.inventory_number AS LoanDTO__inventory_number,
    l.issued_at AS LoanDTO__issued_at,
    l.due_date AS LoanDTO__due,
    l.returned_at AS LoanDTO__returned_at,
    (
        SELECT count(*)
        FROM library.loan_extensions e
        WHERE e.loan_id = l.id
    ) AS LoanDTO__extensions_count
FROM library.loans l
WHERE TRUE
{% if reader_id is not none %}
    AND l.reader_id = {{ reader_id }}
{% endif %}
{% if only_overdue %}
    AND l.returned_at IS NULL
    AND l.due_date < {{ on }}
{% endif %}
{% if only_active %}
    AND l.returned_at IS NULL
{% endif %}
ORDER BY l.id
