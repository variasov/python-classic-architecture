{# Таблица loans - алиас l. #}
{% macro overdue(criteria) -%}
    (l.returned_at IS NULL AND l.due_date < {{ criteria.on }})
{%- endmacro %}

{% macro returned(criteria) -%}
    l.returned_at IS NOT NULL
{%- endmacro %}

{% macro due_within(criteria) -%}
    (
        l.returned_at IS NULL
        AND l.due_date >= {{ criteria.on }}
        AND l.due_date <= {{ criteria.on }}::date + {{ criteria.days }}::integer
    )
{%- endmacro %}

{% macro belongs_to_reader(criteria) -%}
    l.reader_id = {{ criteria.reader_id }}
{%- endmacro %}
